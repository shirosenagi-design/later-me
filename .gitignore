# Private runtime state. The entire data tree may contain reservations,
# transcripts, cancellations, encrypted credentials, or usual-AI memory.
data/
results/
logs/
diagnostics/results/
web/public/pending_call.json
*.log

# Local configuration and credential material
.env
.env.*
!.env.example
*.local
*.dpapi
*.key
*.pem
*.p12
*.pfx

# Local sharing/export bundles
share_for_kai/
*.zip

# Runtime-only diagnostic output
diagnostics/relationship_trace_api_smoke/
diagnostics/**/results/
diagnostics/**/output/
diagnostics/**/artifacts/

# Frontend and package-manager output
node_modules/
dist/
dist-ssr/
build/
.pnpm-store/
.npm/
.yarn/cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
